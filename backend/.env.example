# --- OKOA AI backend environment template ---
# Copy to .env for local dev. NEVER commit real secrets.

ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+psycopg://okoa:okoa@localhost:5432/okoa
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# AES-256 key (base64 of 32 bytes). Generate:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=

# --- WhatsApp Business Cloud API (from Meta developer portal, roadmap 0.1) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=600

ENABLE_CRISIS_KEYWORD_FALLBACK=true
